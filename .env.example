# URL interne de l'API (rendu serveur et redirections)
API_URL=http://localhost:4100
# URL publique du site (métadonnées, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# URL publique de l'API pour Socket.IO (le temps réel ne passe pas par les rewrites Next.js)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4100
# Identifiant OAuth Google (connexion avec Google), identique à celui de l'API
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Secret partagé avec l'API pour vider le cache des pages
REVALIDATE_SECRET=dev-revalidate-secret-change-me
